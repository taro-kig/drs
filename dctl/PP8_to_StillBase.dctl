// PP8_to_StillBase.dctl
// S-Log3 / PP8 の動画を、ノーマライズしたスチルの見た目に寄せるためのDCTL
// 想定: DaVinci Wide Gamut / DaVinci Intermediate の作業空間
// 置く場所: 入力CST(S-Gamut3.Cine/S-Log3 -> DWG/DI) の直後のノード

DEFINE_UI_PARAMS(exposure, Exposure (stops), DCTLUI_SLIDER_FLOAT, 0.0, -3.0, 3.0, 0.01)
DEFINE_UI_PARAMS(contrast, Contrast, DCTLUI_SLIDER_FLOAT, 0.85, 0.5, 1.5, 0.01)
DEFINE_UI_PARAMS(pivot, Pivot, DCTLUI_SLIDER_FLOAT, 0.336, 0.1, 0.6, 0.001)
DEFINE_UI_PARAMS(hlKnee, Highlight Knee, DCTLUI_SLIDER_FLOAT, 0.55, 0.3, 0.9, 0.001)
DEFINE_UI_PARAMS(hlComp, Highlight Compress, DCTLUI_SLIDER_FLOAT, 0.3, 0.0, 1.0, 0.01)
DEFINE_UI_PARAMS(sat, Saturation, DCTLUI_SLIDER_FLOAT, 0.85, 0.0, 2.0, 0.01)

// DaVinci Intermediate で 1段 あたりのコード値
#define DI_STOP 0.07329248f

// DaVinci Wide Gamut の輝度係数
#define LR 0.274454f
#define LG 0.873724f
#define LB -0.148178f

__DEVICE__ float3 transform(int p_Width, int p_Height, int p_X, int p_Y, float p_R, float p_G, float p_B)
{
    float r = p_R;
    float g = p_G;
    float b = p_B;

    // 1. 露出 (ログ空間ではオフセット = リニアのゲイン)
    float ev = exposure * DI_STOP;
    r += ev; g += ev; b += ev;

    // 2. コントラスト (ピボット中心)
    r = (r - pivot) * contrast + pivot;
    g = (g - pivot) * contrast + pivot;
    b = (b - pivot) * contrast + pivot;

    // 3. ハイライト圧縮 (輝度で計算し、RGBに同じオフセットを加えて色相を保つ)
    float Y = r * LR + g * LG + b * LB;
    float d = Y - hlKnee;
    if (d > 0.0f && hlComp > 0.0f) {
        float Yc = hlKnee + d / (1.0f + hlComp * d * 4.0f);
        float off = Yc - Y;
        r += off; g += off; b += off;
        Y = Yc;
    }

    // 4. 彩度 (輝度を保ったまま)
    r = Y + (r - Y) * sat;
    g = Y + (g - Y) * sat;
    b = Y + (b - Y) * sat;

    return make_float3(r, g, b);
}
