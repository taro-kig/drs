// SLog3_Normalize.dctl
// Normalizes S-Log3 footage (e.g. PP8) toward the look of a normalized still.
// Working space: DaVinci Wide Gamut / DaVinci Intermediate.
// Place right after the input CST (S-Gamut3.Cine/S-Log3 -> DWG/DI).
//
// NOTE: keep this file pure ASCII. Non-ASCII text (even in comments) breaks
// the AMD OpenCL compiler and crashes Resolve.

DEFINE_UI_PARAMS(exposure, Exposure stops, DCTLUI_SLIDER_FLOAT, 0.0, -3.0, 3.0, 0.01)
DEFINE_UI_PARAMS(contrast, Contrast, DCTLUI_SLIDER_FLOAT, 0.85, 0.5, 1.5, 0.01)
DEFINE_UI_PARAMS(pivot, Pivot, DCTLUI_SLIDER_FLOAT, 0.336, 0.1, 0.6, 0.001)
DEFINE_UI_PARAMS(hlKnee, Highlight Knee, DCTLUI_SLIDER_FLOAT, 0.55, 0.3, 0.9, 0.001)
DEFINE_UI_PARAMS(hlComp, Highlight Compress, DCTLUI_SLIDER_FLOAT, 0.3, 0.0, 1.0, 0.01)
DEFINE_UI_PARAMS(sat, Saturation, DCTLUI_SLIDER_FLOAT, 0.85, 0.0, 2.0, 0.01)

__DEVICE__ float3 transform(int p_Width, int p_Height, int p_X, int p_Y, float p_R, float p_G, float p_B)
{
    // DaVinci Intermediate code value per stop
    const float diStop = 0.07329248f;
    // DaVinci Wide Gamut luminance weights
    const float wR = 0.274454f;
    const float wG = 0.873724f;
    const float wB = -0.148178f;

    float r = p_R;
    float g = p_G;
    float b = p_B;

    // 1. Exposure (offset in log = gain in linear)
    float ev = exposure * diStop;
    r += ev; g += ev; b += ev;

    // 2. Contrast around the pivot
    r = (r - pivot) * contrast + pivot;
    g = (g - pivot) * contrast + pivot;
    b = (b - pivot) * contrast + pivot;

    // 3. Highlight compression on luminance; the same offset on RGB keeps the hue
    float Y = r * wR + g * wG + b * wB;
    float d = _fmaxf(Y - hlKnee, 0.0f);
    float Yc = hlKnee + d / (1.0f + hlComp * d * 4.0f);
    float Ynew = (Y > hlKnee) ? Yc : Y;
    float off = Ynew - Y;
    r += off; g += off; b += off;
    Y = Ynew;

    // 4. Saturation, luminance preserved
    r = Y + (r - Y) * sat;
    g = Y + (g - Y) * sat;
    b = Y + (b - Y) * sat;

    return make_float3(r, g, b);
}
